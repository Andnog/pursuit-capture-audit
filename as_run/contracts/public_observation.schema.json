{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doctoral-joint-interception/contracts/public_observation.schema.json",
  "title": "Public observation projection",
  "description": "Exactly what the selector may see at one decision. A field absent from this schema is not observable. The schema is closed (additionalProperties false) so that a prohibited field cannot be smuggled in as an extra key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "simulation_time_s", "decision_index", "topology_version", "vehicles", "signals"],
  "properties": {
    "contract_version": {"type": "string", "minLength": 1},
    "simulation_time_s": {"type": "number", "minimum": 0, "maximum": 300},
    "decision_index": {"type": "integer", "minimum": 0, "maximum": 300},
    "topology_version": {"type": "string", "minLength": 1},
    "vehicles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vehicle_id", "vehicle_class", "position_xy_m", "speed_mps", "heading_rad", "lane_id", "lane_position_m", "body_length_m", "body_width_m"],
        "properties": {
          "vehicle_id": {"type": "string", "minLength": 1},
          "vehicle_class": {"type": "string", "enum": ["pursuer", "evader", "traffic"]},
          "position_xy_m": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "speed_mps": {"type": "number", "minimum": 0},
          "heading_rad": {"type": "number", "minimum": -3.141592653589794, "maximum": 3.141592653589794},
          "lane_id": {"type": "string", "minLength": 1},
          "lane_position_m": {"type": "number", "minimum": 0},
          "body_length_m": {"type": "number", "exclusiveMinimum": 0},
          "body_width_m": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal_id", "phase", "remaining_s"],
        "properties": {
          "signal_id": {"type": "string", "minLength": 1},
          "phase": {"type": "string", "minLength": 1},
          "remaining_s": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
