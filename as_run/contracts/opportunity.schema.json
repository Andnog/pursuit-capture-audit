{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doctoral-joint-interception/contracts/opportunity.schema.json",
  "title": "Joint interception opportunity",
  "description": "Serialised form of the Opportunity record specified in docs/METHOD_SPEC_EN.md section 3. A verdict without a reason is invalid, so reasons are required and must be non-empty.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "model_version", "opportunity_id", "corridor", "participants", "arrival_sets", "temporal_verdict", "occupancy_verdict", "movement_verdict", "verdict", "joint_window", "max_contiguous_s", "coverage", "reasons"],
  "properties": {
    "contract_version": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "opportunity_id": {"type": "string", "minLength": 1},
    "corridor": {"type": "string", "minLength": 1},
    "participants": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evader_branch": {"type": ["string", "null"]},
    "arrival_sets": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intervals", "direction"],
        "properties": {
          "intervals": {
            "type": "array",
            "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
          },
          "direction": {"type": "string", "enum": ["UNDER", "OVER", "PREDICTION"]}
        }
      }
    },
    "temporal_verdict": {"$ref": "#/$defs/verdict"},
    "occupancy_verdict": {"$ref": "#/$defs/verdict"},
    "movement_verdict": {"$ref": "#/$defs/verdict"},
    "verdict": {"$ref": "#/$defs/verdict"},
    "joint_window": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
    "max_contiguous_s": {"type": "number", "minimum": 0},
    "margin_s": {"type": ["number", "null"]},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"type": "string", "minLength": 1}, "detail": {"type": "string"}}}}
  },
  "$defs": {"verdict": {"type": "string", "enum": ["SUPPORTED", "REJECTED", "UNKNOWN"]}}
}
